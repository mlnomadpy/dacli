{
  "name": "dacli private pilot",
  "url": "https://dacli.dev",
  "hook_attributes": {
    "active": true,
    "url": "https://REPLACE.example/github/webhook"
  },
  "redirect_url": "https://REPLACE.example/github/setup",
  "public": false,
  "default_permissions": {
    "metadata": "read",
    "issues": "read",
    "pull_requests": "read",
    "checks": "write"
  },
  "default_events": [
    "installation",
    "installation_repositories",
    "issues",
    "issue_comment",
    "pull_request",
    "repository"
  ]
}
