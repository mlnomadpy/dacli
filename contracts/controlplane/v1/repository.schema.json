{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dacli.dev/contracts/controlplane/v1/repository.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["repository_id", "installation_id", "owner", "name", "visibility", "version"],
  "properties": {
    "repository_id": {"type": "string", "minLength": 1, "maxLength": 128}, "installation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "owner": {"type": "string", "minLength": 1, "maxLength": 255}, "name": {"type": "string", "minLength": 1, "maxLength": 255},
    "visibility": {"enum": ["private", "internal", "public"]}, "version": {"type": "integer", "minimum": 1, "maximum": 2147483647}
  }
}
