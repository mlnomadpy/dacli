{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dacli.dev/contracts/controlplane/v1/approval.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["approval_id", "subject_type", "subject_id", "decision", "decided_by", "base_version"],
  "properties": {
    "approval_id": {"type": "string"}, "subject_type": {"enum": ["task_proposal", "run_summary", "policy_bundle"]},
    "subject_id": {"type": "string"}, "decision": {"enum": ["approved", "rejected"]},
    "decided_by": {"type": "string"}, "base_version": {"type": "integer", "minimum": 0}
  }
}
