{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dacli.dev/contracts/controlplane/v1/policy-bundle.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["bundle_id", "version", "effective_at", "rules"],
  "properties": {
    "bundle_id": {"type": "string", "minLength": 1, "maxLength": 128}, "version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "effective_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "rules": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["capability", "effect"], "properties": {"capability": {"type": "string", "minLength": 1, "maxLength": 128}, "effect": {"enum": ["allow", "deny"]}}}}
  }
}
