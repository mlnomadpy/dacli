{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dacli.dev/contracts/controlplane/v1/run-summary.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["run_id", "task_id", "agent_id", "status", "started_at", "finished_at", "commit_ids", "checks"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128}, "task_id": {"type": "string", "minLength": 1, "maxLength": 128}, "agent_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["succeeded", "failed", "refused", "blocked"]},
    "started_at": {"type": "string", "format": "date-time", "maxLength": 64}, "finished_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "commit_ids": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^[0-9a-f]{7,64}$", "maxLength": 64}},
    "checks": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["name", "result"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "result": {"enum": ["pass", "fail", "unverified"]}}}}
  }
}
