    },
    "because": {
      "description": "decisions: why the rejection holds",
      "type": "string"
    },
    "body": {
      "description": "the content",
      "type": "string"
    },
    "kind": {
      "description": "decision | finding | metric | ref",
      "type": "string"
    },
    "project": {
